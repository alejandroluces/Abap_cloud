<mvc:View
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  displayBlock="true"
  controllerName="preview.app.controller.App"
>
  <App>
    <Page title="Proveedores (Vista local)">
      <content>
        <VBox class="sapUiSmallMargin">
          <SearchField
            id="searchField"
            placeholder="Buscar por nombre o ciudad"
            liveChange="onSearch"
          />
          <Table
            id="providersTable"
            items="{path: '/Providers'}"
            growing="true"
            growingScrollToLoad="true"
          >
            <headerToolbar>
              <OverflowToolbar>
                <Title text="Lista de Proveedores" level="H2"/>
                <ToolbarSpacer />
                <Button 
                  text="Crear Proveedor" 
                  type="Emphasized" 
                  icon="sap-icon://add" 
                  press="onOpenCreateDialog" />
              </OverflowToolbar>
            </headerToolbar>
            <columns>
              <Column><Text text="ID" /></Column>
              <Column><Text text="Nombre" /></Column>
              <Column><Text text="País" /></Column>
              <Column><Text text="Ciudad" /></Column>
              <Column><Text text="Banco" /></Column>
            </columns>
            <items>
              <ColumnListItem>
                <cells>
                  <Text text="{ProviderID}" />
                  <Text text="{Name}" />
                  <Text text="{Country}" />
                  <Text text="{City}" />
                  <Text text="{BankType}" />
                </cells>
              </ColumnListItem>
            </items>
          </Table>
        </VBox>
      </content>
      <dependents>
        <Dialog id="createProviderDialog" title="Crear Nuevo Proveedor">
          <content>
            <VBox class="sapUiSmallMargin">
              <Label text="ID Proveedor (Ej: P0004)" required="true"/>
              <Input id="inpId" />
              <Label text="Nombre" required="true"/>
              <Input id="inpName" />
              <Label text="País (Ej: CL, PE)"/>
              <Input id="inpCountry" />
              <Label text="Ciudad"/>
              <Input id="inpCity" />
              <Label text="Calle"/>
              <Input id="inpStreet" />
              <Label text="Tipo de Cuenta (Ej: CTA_CORRIENTE)"/>
              <Input id="inpBankType" />
            </VBox>
          </content>
          <beginButton>
            <Button text="Guardar" type="Emphasized" press="onSaveProvider"/>
          </beginButton>
          <endButton>
            <Button text="Cancelar" press="onCancelCreate"/>
          </endButton>
        </Dialog>
      </dependents>
    </Page>
  </App>
</mvc:View>
