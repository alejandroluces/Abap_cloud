@Metadata.layer: #CORE
@UI.headerInfo: {
  typeName: 'Articulo',
  typeNamePlural: 'Articulos',
  title: { value: 'MatId' },
  description: { value: 'MatDesc' }
}
annotate view ZMM_I_INV_MAT with
{
  /* ======== Facet (seccion en Object Page) ======== */
  @UI.facet: [
    { id: 'General', type: #IDENTIFICATION_REFERENCE, label: 'Articulo', position: 10 }
  ]

  /* ======== LIST REPORT (tabla) + OBJECT PAGE (detalle) ======== */

  @UI.lineItem:         [ { position: 10, criticality: 'Criticality', label: 'Material' } ]
  @UI.identification:   [ { position: 10, label: 'Material' } ]
  @UI.selectionField:   [ { position: 10 } ]
  MatId;

  @UI.lineItem:         [ { position: 20, criticality: 'Criticality', label: 'Descripcion' } ]
  @UI.identification:   [ { position: 20, label: 'Descripcion' } ]
  @UI.selectionField:   [ { position: 20 } ]
  MatDesc;

  @UI.lineItem:         [ { position: 30, label: 'Precio' } ]
  @UI.identification:   [ { position: 30, label: 'Precio' } ]
  MatPrice;

  @UI.lineItem:         [ { position: 40, label: 'Stock', criticality: 'Criticality' } ]
  @UI.identification:   [ { position: 40, label: 'Stock' } ]
  StockActual;

  @UI.lineItem:         [ { position: 50, label: 'Valor Stock', criticality: 'Criticality' } ]
  @UI.identification:   [ { position: 50, label: 'Valor Stock' } ]
  ValorStock;

  @UI.lineItem:         [ { position: 60, label: 'URL' } ]
  @UI.identification:   [ { position: 60, label: 'URL' } ]
  MatUrl;
}